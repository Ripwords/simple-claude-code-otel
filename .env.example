# Provisioned by `vercel integration add neon`.
DATABASE_URL=

# Provisioned by `vercel integration add neon`. Used to sign in to the dashboard.
NEON_AUTH_BASE_URL=

# Secret the retention cron presents when it is not called by Vercel Cron.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Days of telemetry to keep. The daily cron deletes anything older.
RAW_RETENTION_DAYS=7
ROLLUP_RETENTION_DAYS=400
DB_SIZE_ALARM_BYTES=419430400

# Optional, but needed to stay inside Neon's free compute hours. Ingest is buffered in Upstash
# Redis and written to Neon at most every 30 minutes, or when the dashboard is opened, so the
# database can sleep. Unset means every request writes straight to Neon.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
