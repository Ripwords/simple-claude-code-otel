# Provisioned by `vercel integration add neon`.
DATABASE_URL=

# Provisioned by `vercel integration add neon`. Used to sign in to the dashboard.
NEON_AUTH_BASE_URL=

# Secret the retention cron presents when it is not called by Vercel Cron.
# Generate with: openssl rand -hex 24
CRON_SECRET=

# Days of telemetry to keep. The daily cron deletes anything older.
RETENTION_DAYS=90
